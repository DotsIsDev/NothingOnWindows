  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource GlassButtonFill}"/><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="CaretBrush" Value="#F4F4F4"/><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#C4E0E0E0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#697F7F7F"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="18" Padding="4">
 <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="51"/><RowDefinition Height="25"/></Grid.RowDefinitions>
  <Grid x:Name="GlassBackdrop" Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
   <Viewbox Stretch="Fill"><Canvas Width="440" Height="800" Background="#080808">
    <Ellipse Canvas.Left="-210" Canvas.Top="-70" Width="480" Height="440"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#702C2C2C" Offset="0"/><GradientStop Color="#00212121" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="45"/></Ellipse.Effect></Ellipse>
    <Ellipse Canvas.Left="180" Canvas.Top="280" Width="420" Height="470"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#70343434" Offset="0"/><GradientStop Color="#00242424" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="55"/></Ellipse.Effect></Ellipse>
    <Ellipse Canvas.Left="-100" Canvas.Top="610" Width="330" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#352E2E2E" Offset="0"/><GradientStop Color="#00202020" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><BlurEffect Radius="55"/></Ellipse.Effect></Ellipse>
    <Path Data="M -50,620 C 140,510 260,170 500,190" Stroke="#107D7D7D" StrokeThickness="30"><Path.Effect><BlurEffect Radius="25"/></Path.Effect></Path>
   </Canvas></Viewbox>
  </Grid>
  <Border Grid.Row="0" Background="#0FFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Margin="0,0,0,2"/>
  <Grid Margin="13,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/headphones.ico" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><ui:DotMatrixLabel Text="NOTHING" Width="94" Height="19"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0"><Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="#929292" Margin="0,0,6,0"/><TextBlock x:Name="ConnectionBadge" Text="Offline" FontSize="9" Foreground="#BDBDBD"/></StackPanel>
   <Button x:Name="MinimizeButton" Grid.Column="2" Content="—" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" Padding="0" Margin="0" Width="32" Height="30"/>
   <Button x:Name="CloseButton" Grid.Column="3" Content="×" Click="Close_Click" AutomationProperties.Name="Close" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" FontSize="20" Padding="0" Margin="0" Width="32" Height="30"/>
  </Grid>
  <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,6,14,0">
   <StackPanel>
    <StackPanel x:Name="DevicePanel" Margin="0,0,0,14">
     <Image x:Name="ProductPhoto" Source="Assets/headphone-a-product.png" Width="132" Height="132" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Nothing Headphone (a), black product photo"/>
     <TextBlock x:Name="DeviceName" Text="Headphone (a)" FontFamily="Georgia" FontSize="21" HorizontalAlignment="Center"/>
     <TextBlock x:Name="ProfileStatusLabel" Text="" Foreground="#999999" FontSize="9" TextAlignment="Center" Margin="0,5,0,0"/>
     <TextBlock x:Name="BatteryLabel" Text="— Battery" FontSize="11" Foreground="#BBBBBB" HorizontalAlignment="Center" Margin="0,7,0,0"/>
     <TextBlock x:Name="DeviceDetail" Text="Ready to connect" Foreground="#999999" FontSize="10" TextAlignment="Center" Margin="0,5,0,10"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Background="#F4F4F4" Foreground="#000000" FontSize="11" Padding="20,7" Margin="0,0,5,0"/><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Background="Transparent" Foreground="#AAAAAA" FontSize="11" Padding="10,7" Margin="0" IsEnabled="False"/></StackPanel>
    </StackPanel>
    <TextBlock x:Name="PageTitle" Text="Sound" FontFamily="Georgia" FontSize="25" Margin="0,4,0,17"/>
    <StackPanel x:Name="PageContent"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#14FFFFFF" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="17" Margin="10,4,10,0"><UniformGrid x:Name="Navigation" Columns="5" VerticalAlignment="Center" Margin="3,0"/></Border>
  <TextBlock x:Name="StatusLabel" Grid.Row="3" Text="Connect your headphones to begin." FontSize="10" Foreground="#AAAAAA" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="14,0,14,4" VerticalAlignment="Center" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
 </Grid></Border>
</Window>
