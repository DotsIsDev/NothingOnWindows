<Window x:Class="NothingOnWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:NothingOnWindows.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Nothing on Windows" Icon="Assets/headphones.ico" Width="440" Height="800" MinWidth="330" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" Background="#080808" Foreground="#F4F4F4" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
